# Server environment — copy to server/.env when running the API from server/
# (the repo-root .env.example lists the same server variables)
# Never commit a real .env — this file has placeholder values only.

# ---- Core ----
PORT=4000
NODE_ENV=development
DATABASE_URL=<redacted>
JWT_SECRET=<redacted>
JWT_ACCESS_TTL_MIN=15
# Comma-separated origins allowed to call the API (the web client origin)
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
AUTH_RATE_MAX=50
# Bootstrap admin (created by `npm run seed:admin` in server/, never self-registered)
ADMIN_EMAIL=
ADMIN_PASSWORD=<redacted>
ADMIN_NAME=Admin
# Public base URL of this API, used in sitemap.xml
PUBLIC_BASE_URL=http://localhost:4000
# Optional free SMTP for email alerts (e.g. a Gmail app password). If unset, email alerts are queued and logged, never marked sent.
SMTP_HOST=
SMTP_PORT=587
# false for plain SMTP on port 587; true only for implicit-TLS port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: WhatsApp alert delivery webhook (if unset, WhatsApp alerts are queued and logged, never marked sent)
WHATSAPP_WEBHOOK_URL=
# Skip the collector scheduler (it starts unless this is 'true') — for local dev / one-off runs
DISABLE_SCHEDULER=true
