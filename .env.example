# ---- Server ----
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/jobportal
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL_MIN=15
# Comma-separated origins allowed to call the API (the web client origin)
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
AUTH_RATE_MAX=50
# Bootstrap admin (created by `npm run seed:admin` in server/, never self-registered)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Public base URL of this API, used in sitemap.xml
PUBLIC_BASE_URL=http://localhost:4000
# Optional free SMTP for email alerts (e.g. a Gmail app password). If unset, email alerts are queued and logged, never marked sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: WhatsApp alert delivery webhook (if unset, WhatsApp alerts are queued and logged, never marked sent)
WHATSAPP_WEBHOOK_URL=
# ---- Client (copied to client/.env) ----
VITE_API_BASE=http://localhost:4000
# Brand label shown in the UI (working title until I pick a product name)
VITE_APP_NAME=Verified Jobs
