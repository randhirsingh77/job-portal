# Client env vars — copy this file to client/.env and adjust for your setup.
# Both have defaults (client/src/lib/api.ts), so the file is optional;
# the root .env.example documents the same values for copying to client/.env.

# Base URL of the API server (defaults to http://localhost:4000 when unset)
VITE_API_BASE=http://localhost:4000
# Brand label shown in the UI (defaults to 'Verified Jobs' when unset)
VITE_APP_NAME=Verified Jobs
